# Modèle du .env du bot live : copier en .env puis remplir (ne jamais versionner le .env).
# Les variables marquées (requis) font échouer le démarrage si elles sont absentes.

# --- Discord ---
DISCORD_TOKEN=
# Choisit la colonne d'emotes (bot/render/emotes.py).
BOT_ID=live
# Serveur de contrôle où /refresh est enregistrée.
CONTROL_GUILD_ID=
# Auteur du bot : droit sur /refresh et destinataire des DM d'alerte.
OWNER_ID=

# --- Bungie ---
BUNGIE_API_KEY=

# Personnage de référence pour les rotations weekly/daily.
BUNGIE_MEMBERSHIP_TYPE=
BUNGIE_MEMBERSHIP_ID=
BUNGIE_CHARACTER_ID=

# Personnages secondaires, seulement pour les vendors dépendants de la classe (Eververse).
BUNGIE_WARLOCK_ID=
BUNGIE_HUNTER_ID=

# OAuth (client Confidential), seulement pour Xûr. Le refresh_token vit en base.
BUNGIE_CLIENT_ID=
BUNGIE_CLIENT_SECRET=

# --- Base d'état du live (compute_*, bot_*) ---
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- Base de contenu (content_*), écrite par le live et lue par le lite ---
CONTENT_DB_HOST=
CONTENT_DB_PORT=
CONTENT_DB_NAME=
CONTENT_DB_USER=
CONTENT_DB_PASSWORD=
